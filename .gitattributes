# Normalise text files in the repository and keep Windows scripts native.
* text=auto eol=lf

*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.vbs  text eol=crlf
*.sh   text eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.exe  binary
*.dll  binary
*.zip  binary
